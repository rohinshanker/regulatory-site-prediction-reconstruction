{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template",
    "ligand_total_molar",
    "seconds_total"
  ],
  "properties": {
    "schema_version": {
      "const": "conditional-sweep-request-1"
    },
    "template": {
      "allOf": [
        {
          "$ref": "conditional-aptamer-request-1.schema.json"
        },
        {
          "properties": {
            "profile": {
              "const": "supplied_energy_response"
            },
            "input": {
              "properties": {
                "occupancy": {
                  "properties": {
                    "mode": {
                      "const": "published2015_volume"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ligand_total_molar": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "conditional-aptamer-request-1.schema.json#/$defs/number",
        "minimum": 0
      }
    },
    "seconds_total": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conditional concentration sweep request 1",
  "$comment": "Structural schema. Runtime enforces finite raw JSON, byte/depth/node limits, complete native admission and positive/nonnegative scientific relationships. Preserve point order and duplicates; no inferred concentration grid."
}
