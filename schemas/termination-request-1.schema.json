{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regsite.local/schemas/termination-request-1.schema.json",
  "title": "Termination request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": "termination-request-1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
          },
          "sequence": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "per_record_seconds"
      ],
      "properties": {
        "max_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 300
        },
        "per_record_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 60
        }
      }
    }
  }
}
