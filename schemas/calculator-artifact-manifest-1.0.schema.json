{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rohinshanker/regulatory-site-prediction-reconstruction/raw/main/schemas/calculator-artifact-manifest-1.0.schema.json",
  "title": "Explicit calculator artifact byte manifest 1.0",
  "description": "Caller-declared producer metadata and opaque local byte references; no scientific validity, origin authenticity, licence or result admission is certified. Runtime additionally checks unique IDs/paths, strict JSON syntax, read limits and filesystem safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_repository",
    "producer_commit",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "calculator-artifact-manifest-1.0"
    },
    "producer_repository": {
      "type": "string",
      "const": "https://github.com/rohinshanker/regulatory-site-prediction-reconstruction"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "request",
              "result",
              "benchmark",
              "report",
              "parameter"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])",
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
