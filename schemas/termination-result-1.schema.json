                "pattern": "[/\\\\]"
              }
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\x20-\\x7e]+$",
              "not": {
                "pattern": "[/\\\\]"
              }
            },
            "machine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\x20-\\x7e]+$",
              "not": {
                "pattern": "[/\\\\]"
              }
            },
            "standard_library": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\x20-\\x7e]+$",
              "not": {
                "pattern": "[/\\\\]"
              }
            },
            "flags": {
              "const": [
                "-g",
                "-O3",
                "-Wall",
                "-pedantic",
                "-std=c++11",
                "-ffp-contract=off"
