          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "status": {
          "enum": [
            "ok",
            "boundary_ambiguous"
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          ]
        },
        "hairpin_score": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^-(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:e[+-]?[0-9]+)?$"
        },
        "tail_score": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^-(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:e[+-]?[0-9]+)?$"
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "context",
            "printed_confidence",
            "notes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^TERM [1-9][0-9]{0,3}$"
            },
            "context": {
              "enum": [
                "F",
                "f",
                "G"
              ]
            },
            "printed_confidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "notes": {
              "type": "string",
              "maxLength": 16384
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "boundary_ambiguous"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "strand": {
                "const": "+"
              },
              "hairpin": {
                "properties": {
                  "start": {
                    "const": 1
                  }
                }
              },
              "native": {
                "properties": {
                  "context": {
                    "enum": [
                      "F",
                      "G"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "confidence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "strand": {
                "const": "-"
              }
            }
          },
          "then": {
            "properties": {
              "native": {
