      "properties": {
        "id": {
          "const": "transtermhp-2.09-fragment-1"
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "source_doi": {
          "const": "10.1186/gb-2007-8-2-r22"
        },
        "source_archive_sha256": {
          "const": "b636db1c0fe9731cc760d8f3639209d07f7f35309d83013cc9f9e40798ce8be0"
        },
        "background_sha256": {
          "const": "fce89a92ab487aaea5a54015e859e1fb5e31f4f9985c9df7831ee09a367db1fe"
