  "properties": {
    "schema_version": {
      "const": "termination-result-1"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation_version",
        "source_doi",
        "source_archive_sha256",
        "background_sha256",
