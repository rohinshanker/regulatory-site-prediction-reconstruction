          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "total_energy": {
                "type": "number"
              },
              "standby_energy": {
                "type": "number",
                "minimum": 0
              },
              "negative_unfolding_seen": {
                "type": "boolean"
              },
              "state_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "states_evaluated": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "total_energy": {
                "type": "null"
              },
              "standby_energy": {
                "type": "null"
              },
              "negative_unfolding_seen": {
                "type": "null"
              }
            }
          }
        }
      ]
