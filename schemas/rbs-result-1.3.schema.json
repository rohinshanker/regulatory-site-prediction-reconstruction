        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_energy": {
          "type": [
            "number",
            "null"
          ]
        },
        "standby_energy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "state_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "states_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "negative_unfolding_seen": {
