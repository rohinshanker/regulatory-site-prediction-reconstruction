    "joint_search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "connected": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "state_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "states_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "selected_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^cofold-[0-9]+-[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "greedy_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "greedy_candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^cofold-[0-9]+-[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "greedy_total_energy": {
          "type": [
            "number",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/joint_candidate"
          }
        }
