        "complete",
        "selected_index",
        "selected_candidate_id",
        "greedy_index",
        "greedy_candidate_id",
        "greedy_total_energy",
        "candidates"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "selected_index": {
                "type": "null"
              },
              "selected_candidate_id": {
                "type": "null"
              },
              "greedy_index": {
                "type": "null"
              },
              "greedy_candidate_id": {
                "type": "null"
              },
              "greedy_total_energy": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              },
              "eligible": {
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "selected_index": {
                "type": "integer",
                "minimum": 0
              },
              "greedy_index": {
                "type": "integer",
                "minimum": 0
              },
              "selected_candidate_id": {
                "type": "string",
                "pattern": "^cofold-[0-9]+-[0-9a-f]{64}$"
              },
              "greedy_candidate_id": {
                "type": "string",
                "pattern": "^cofold-[0-9]+-[0-9a-f]{64}$"
              },
              "greedy_total_energy": {
                "type": "number"
              },
              "failed": {
                "const": 0
              },
              "not_evaluated": {
                "const": 0
              }
            }
          }
        }
      ]
    }
