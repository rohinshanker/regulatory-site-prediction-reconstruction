{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rohinshanker/regulatory-site-prediction-reconstruction/raw/main/schemas/calculator-job-manifest-1.schema.json",
  "title": "Offline calculator job manifest 1",
  "description": "Caller-authored requests, fixed calculator kinds, whitelisted options and resource limits. Job IDs must also be unique after NFC casefolding and output_bytes_total must be at least the two per-job caps. Runtime checks additionally enforce strict JSON syntax, byte limits and filesystem rules; hashes bind bytes only and establish neither scientific validity nor authenticity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobs",
    "limits",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "calculator-job-manifest-1"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_bytes_total",
        "seconds_per_job",
        "seconds_total",
        "stderr_bytes_per_job",
        "stdout_bytes_per_job"
      ],
      "properties": {
        "seconds_per_job": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "seconds_total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "stdout_bytes_per_job": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "stderr_bytes_per_job": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "output_bytes_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "id",
              "kind",
              "options",
              "request"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "rbs"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  }
                }
              },
              "backend": {
                "const": true
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile": {
                    "enum": [
                      "historical",
                      "footprint2017",
                      "context2017",
                      "standby2014",
                      "joint_standby"
                    ]
                  },
                  "seconds_per_record": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "id",
              "kind",
              "options",
              "request"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "promoter"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  }
                }
              },
              "backend": {
                "const": false
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "calibration": {
                    "enum": [
                      "ecoli_mg1655",
                      "in_vitro"
                    ]
                  },
                  "states": {
                    "enum": [
                      "selected",
                      "all"
                    ]
                  },
                  "seconds_per_record": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "seconds_per_batch": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "id",
              "kind",
              "options",
              "request"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "compare"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  }
                }
              },
              "backend": {
                "type": "boolean"
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "id",
              "kind",
              "options",
              "request"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "transcript"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  }
                }
              },
              "backend": {
                "type": "boolean"
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "id",
              "kind",
              "options",
              "request"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "const": "conditional"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255}(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]{1,255})*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  }
                }
              },
              "backend": {
                "type": "boolean"
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    }
  }
}
