    {"id": "duplicate_pair", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[1, 16], [1, 16]], "expected_error": "duplicate_pair"},
    {"id": "conflicting_partner", "sequence": "GGGAGCGAAAGCUCCCAAAAAAAAGCUCCC", "mode": "partial", "forced_pairs": [[1, 16], [1, 30]], "expected_error": "position_in_multiple_pairs"},
    {"id": "paired_and_unpaired", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[1, 16]], "forced_unpaired": [16], "expected_error": "paired_and_unpaired"},
    {"id": "duplicate_unpaired", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_unpaired": [3, 3], "expected_error": "duplicate_unpaired"},
    {"id": "noncanonical", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[4, 10]], "expected_error": "noncanonical_pair"},
    {"id": "short_hairpin", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[6, 7]], "expected_error": "hairpin_too_short"},
    {"id": "out_of_range", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[1, 17]], "expected_error": "position_out_of_range"},
    {"id": "reversed_pair", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_pairs": [[16, 1]], "expected_error": "pair_not_5prime_first"},
    {"id": "boolean_position", "sequence": "GGGAGCGAAAGCUCCC", "mode": "partial", "forced_unpaired": [true], "expected_error": "invalid_position"},
    {"id": "dna_base", "sequence": "GGGAGCGAAAGCTCCC", "mode": "unconstrained", "expected_error": "unsupported_base"},
    {"id": "ambiguous_base", "sequence": "GGGAGCGAAAGCNCCC", "mode": "unconstrained", "expected_error": "unsupported_base"},
    {"id": "unbalanced", "sequence": "GGGAGCGAAAGCUCCC", "mode": "full", "structure": "(((((((...))))))", "expected_error": "unbalanced_structure"},
    {"id": "length_mismatch", "sequence": "GGGAGCGAAAGCUCCC", "mode": "full", "structure": "((((((....)))))", "expected_error": "structure_length_mismatch"},
    {"id": "constraint_on_unconstrained", "sequence": "GGGAGCGAAAGCUCCC", "mode": "unconstrained", "forced_pairs": [[1, 16]], "expected_error": "unexpected_field"},
    {"id": "unknown_mode", "sequence": "GGGAGCGAAAGCUCCC", "mode": "soft", "expected_error": "invalid_mode"}
  ]
}
